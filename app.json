{
  "expo": {
    "name": "ResuMate",
    "slug": "ResuMate",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "resumate",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/resumate-app-assets/android/splash/android-splash-1920x1920.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/resumate-app-assets/ios/icons/ios-icon-512.png",
      "splash": {
        "image": "./assets/images/resumate-app-assets/ios/splash/ios-splash-2732x2732.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      }
    },
    "android": {
      "icon": "./assets/images/resumate-app-assets/android/icons/android-icon-512.png",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/resumate-app-assets/android/icons/android-icon-512.png"
      },
      "splash": {
        "image": "./assets/images/resumate-app-assets/android/splash/android-splash-1920x1920.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arhanansari.ResuMate"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/resumate-app-assets/ios/icons/ios-icon-72.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/resumate-app-assets/android/splash/android-splash-1920x1920.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "resumate",
          "organization": "arhanansari"
        }
      ],
      "@sentry/react-native",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ced5c952-f7f1-46e5-83fa-39bf177e8017"
      }
    }
  }
}
